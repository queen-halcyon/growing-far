[sub_resource type="GDScript" id="GDScript_hug1h"]
script/source = "extends MarginContainer

func _ready() -> void:
	if DataGlobal.shown_minigame_tutorial:
		visible = false

func _on_button_pressed() -> void:
	DataGlobal.shown_minigame_tutorial = true
	visible = false
"

